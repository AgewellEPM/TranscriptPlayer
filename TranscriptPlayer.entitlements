<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Speech Recognition Entitlement -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- File Access (for opening videos) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Disable App Sandbox for easier file access during development -->
	<!-- Enable this in production and configure proper file access -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- User Selected File Access -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>

	<!-- Downloads folder access -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Network access for potential future features -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
